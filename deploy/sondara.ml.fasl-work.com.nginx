server {
    server_name sondara.ml.fasl-work.com;
    root /var/www/sondara.ml.fasl-work.com;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
    location /data/ { add_header Cache-Control "public, max-age=3600"; }
    location /assets/ { add_header Cache-Control "public, max-age=604800, immutable"; }

    listen 80;
}
