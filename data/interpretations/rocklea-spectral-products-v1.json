  "registration": {
    "compare": ["Al2O3", "SiO2", "CaO", "MgO", "TiO2", "LOI"],
    "offsets": [-2, -1, 1, 2],
    "rule": "a hole is confirmed when every export row that carries the compared assays equals the workbook at the same hole and depth; a spectral row is paired with an assay interval only in a confirmed hole"
