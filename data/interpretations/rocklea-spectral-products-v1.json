  "spectral": [
    {"column": "Fe ox ai", "product": "Ferric oxide abundance (Ferric_oxide_abundance.txt)", "unit": "relative absorption depth", "kind": "abundance"},
    {"column": "hem/goe", "product": "Hematite-goethite distribution (Hematite-goethite_distr.txt)", "unit": "nm (absorption wavelength)", "kind": "composition"},
    {"column": "kaolin abundance", "product": "Kaolin abundance index", "unit": "relative absorption depth", "kind": "abundance"},
    {"column": "kaolin composition", "product": "Kaolin composition index", "unit": "band ratio", "kind": "composition"},
    {"column": "wmAlsmai", "product": "White mica and Al-smectite abundance (wmAlsmai.txt)", "unit": "relative absorption depth", "kind": "abundance"},
    {"column": "wmAlsmci", "product": "White mica and Al-smectite composition (wmAlsmci.txt)", "unit": "nm (absorption wavelength)", "kind": "composition"},
    {"column": "carbai3pfit", "product": "Carbonates abundance (carbai3pfit.txt)", "unit": "relative absorption depth", "kind": "abundance"},
    {"column": "carbci3pfit", "product": "Carbonate composition (carbci3pfit.txt)", "unit": "nm (absorption wavelength)", "kind": "composition"}
