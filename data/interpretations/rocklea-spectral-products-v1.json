  "embeddedAssays": {
    "Fe %": {"analyte": "Fe", "comparison": "whole percent, rounded half to even"},
    "Al2O3": {"analyte": "Al2O3", "comparison": "exact"},
    "SiO2 %": {"analyte": "SiO2", "comparison": "exact"},
    "K2O %": {"analyte": "K2O", "comparison": "exact"},
    "CaO %": {"analyte": "CaO", "comparison": "exact"},
    "MgO %": {"analyte": "MgO", "comparison": "exact"},
    "TiO2 %": {"analyte": "TiO2", "comparison": "exact"},
    "P %": {"analyte": "P", "comparison": "exact"},
    "S %": {"analyte": "S", "comparison": "exact"},
    "Mn %": {"analyte": "Mn", "comparison": "exact"},
    "LOI": {"analyte": "LOI", "comparison": "exact"}
